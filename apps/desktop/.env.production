# Production build config for the packaged .exe.
# Not a secret — this is the public API endpoint. Vite auto-loads this file for the
# renderer during `vite build`, and the Electron main process loads it at runtime
# (see main.ts) so the CSP connect-src matches the renderer's API origin.
VITE_API_BASE_URL=https://sagarpharma.duckdns.org
