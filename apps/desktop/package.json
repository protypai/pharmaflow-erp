{
  "name": "pharmaflow-desktop",
  "version": "1.0.54",
  "description": "PharmaFlow ERP Windows Desktop Application",
  "author": "PharmaFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/protypai/pharmaflow-erp.git"
  },
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -o better-sqlite3,keytar || echo \"electron-rebuild skipped (run 'npm run rebuild' before 'npm run dev')\"",
    "rebuild": "electron-rebuild -f -o better-sqlite3,keytar",
    "dev": "tsc && node -e \"require('fs').cpSync('electron/migrations', 'dist-electron/electron/migrations', {recursive:true})\" && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && node -e \"require('fs').cpSync('electron/migrations', 'dist-electron/electron/migrations', {recursive:true})\" && vite build && node scripts/validate-build.js",
    "preview": "npm run build && electron . --prod",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.1.2",
    "electron-updater": "^6.3.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.24.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
