# Server
NODE_ENV=development
PORT=5000

# Database
POSTGRES_USER=pharmaflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=pharmaflow_dev
DATABASE_URL=postgresql://pharmaflow:devpassword@localhost:5432/pharmaflow_dev

# Auth
JWT_SECRET=your_64_char_hex_secret_here_min_32_chars_never_hardcode
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_64_char_hex_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Super Admin (set via GitHub Secrets in CI)
ADMIN_EMAIL=admin@pharmaflow.in
ADMIN_PASSWORD=changeme_strong_password

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM_NAME=PharmaFlow ERP
EMAIL_FROM_ADDRESS=noreply@pharmaflow.in

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=info
RUN_SEEDING=false
