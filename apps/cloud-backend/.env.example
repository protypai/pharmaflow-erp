# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=pharmaflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=pharmaflow_dev
# REQUIRED in production (no default is applied when NODE_ENV=production).
DATABASE_URL=postgresql://pharmaflow:devpassword@localhost:5432/pharmaflow_dev

# ─── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production. The server FAILS TO START if these are missing or shorter
# than 32 characters when NODE_ENV=production (no fallback secret is ever used).
# In development/test a safe local default is applied automatically so `npm run dev`
# works without a .env — never rely on those defaults in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Super Admin ───────────────────────────────────────────────────────────
# REQUIRED in production (set via CI/deployment secrets, never commit real values).
# Used to seed/update the SuperAdmin account. No default is applied in production.
ADMIN_EMAIL=replace-with-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ─── CORS ──────────────────────────────────────────────────────────────────
# Defaults to '*' when unset. Set an explicit origin in production.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Logging / Misc ────────────────────────────────────────────────────────
LOG_LEVEL=info
RUN_SEEDING=false
