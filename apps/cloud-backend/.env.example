# Server
NODE_ENV=development
PORT=5000

# Database
POSTGRES_USER=pharmaflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=pharmaflow_dev
DATABASE_URL=postgresql://pharmaflow:devpassword@localhost:5432/pharmaflow_dev

# Auth
JWT_SECRET=your_64_char_hex_secret_here_min_32_chars_never_hardcode
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_64_char_hex_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Super Admin (set via GitHub Secrets in CI or a local .env file)
ADMIN_EMAIL=replace-with-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
RUN_SEEDING=false
