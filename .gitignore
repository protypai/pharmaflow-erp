# PharmaFlow ERP — Monorepo

node_modules/
dist/
apps/*/dist/
# Compiled Electron output (build artifact, should not be committed)
apps/desktop/dist-electron/
.env
.env.production
.env.local

# Exception: the desktop production build config is NOT a secret — it only holds
# the public API endpoint, and the packaged build needs it committed.
!apps/desktop/.env.production
*.db
*.db-shm
*.db-wal
release/
out/
.turbo/
*.log
backups/
